// =============================================================================
// PRISMA SCHEMA — GIGIN'S BUSINESS CENTRE
// Multi-Business ERP & POS System (Pharmacy, Retail Toys, etc.)
// Provider  : PostgreSQL
// =============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// ENUMS
// =============================================================================

enum BusinessType {
  PHARMACY
  RETAIL_TOYS
}

enum BusinessRole {
  OWNER
  MANAGER
  KASIR
}

enum UserRole {
  OWNER
  ADMIN
  APOTEKER
  TTK
  KASIR
  MANAJER
}

enum StockTransactionType {
  PURCHASE
  SALE
  PURCHASE_RETURN
  SALE_RETURN
  OPNAME
  ADJUSTMENT
  CONSIGNMENT_IN
  CONSIGNMENT_OUT
}

enum OpnameStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum ConsignmentStatus {
  DRAFT
  SENT
  PAID
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

enum PurchaseStatus {
  DRAFT
  POSTED
  PARTIAL_PAID
  PAID
}

enum PurchaseReturnStatus {
  DRAFT
  POSTED
}

enum PaymentMethod {
  CASH
  TRANSFER
  GIRO
}

enum CustomerTier {
  REGULAR
  SILVER
  GOLD
  PLATINUM
}

enum PromoType {
  DISCOUNT_PCT
  DISCOUNT_AMOUNT
  BUY_X_GET_Y
  FREE_ITEM
}

enum WaTemplateType {
  RECEIPT
  PROMO
  REFILL_REMINDER
  BIRTHDAY
}

enum WaLogStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum SaleType {
  GENERAL
  PRESCRIPTION
  COMPOUNDING
}

enum SaleStatus {
  DRAFT
  COMPLETED
  RETURNED
  PARTIAL_RETURN
}

enum SalePaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  QRIS
  CREDIT
}

enum SaleReturnStatus {
  DRAFT
  POSTED
}

enum OnlineChannel {
  VMEDISMART
  KLIKDOKTER
  WEBSTORE
  OTHER
}

enum OnlineOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  COGS
}

enum JournalReferenceType {
  PURCHASE
  PURCHASE_RETURN
  SALE
  SALE_RETURN
  PAYMENT
  ADJUSTMENT
  OPNAME
  CONSIGNMENT
}

enum LoginStatus {
  SUCCESS
  FAILED
}

enum ActivityModule {
  POS
  PRODUCT
  PURCHASE
  STOCK
  FINANCE
  USER
  CRM
  SETTING
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  VOID
  LOGIN
  LOGOUT
  APPROVE
  REJECT
}

// =============================================================================
// DOMAIN 0: MULTI-BUSINESS & TENANCY (GIGIN'S BUSINESS CENTRE)
// =============================================================================

model Business {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  type           BusinessType   @default(PHARMACY)
  enabledModules Json?
  description    String?
  address        String?
  phone          String?
  email          String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Multi-tenant Relations
  userAccesses           UserBusinessAccess[]
  productCategories      ProductCategory[]
  units                  Unit[]
  suppliers              Supplier[]
  products               Product[]
  productBatches         ProductBatch[]
  priceHistories         PriceHistory[]
  stockCards             StockCard[]
  stockOpnames           StockOpname[]
  consignmentSettlements ConsignmentSettlement[]
  purchaseOrders         PurchaseOrder[]
  purchases              Purchase[]
  purchaseReturns        PurchaseReturn[]
  purchasePayments       PurchasePayment[]
  customers              Customer[]
  memberTiers            MemberTier[]
  promos                 Promo[]
  doctors                Doctor[]
  waTemplates            WaTemplate[]
  waLogs                 WaLog[]
  shifts                 Shift[]
  sales                  Sale[]
  saleReturns            SaleReturn[]
  onlineOrders           OnlineOrder[]
  chartOfAccounts        ChartOfAccount[]
  journalEntries         JournalEntry[]
  appSettings            AppSetting[]
  onlineChannelConfigs   OnlineChannelConfig[]
  auditLogs              AuditLog[]
  loginHistories         LoginHistory[]
  activityLogs           ActivityLog[]

  @@index([slug])
  @@index([type])
  @@index([isActive])
}

model UserBusinessAccess {
  id         String       @id @default(cuid())
  userId     String
  businessId String
  role       BusinessRole @default(KASIR)
  permissions Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  loginHistories LoginHistory[]
  activityLogs   ActivityLog[]

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
  @@index([role])
}

// =============================================================================
// DOMAIN 1: USER & RBAC
// =============================================================================

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  hashedPassword String
  role           UserRole @default(KASIR)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  businessAccesses       UserBusinessAccess[]
  auditLogs              AuditLog[]
  productCategories      ProductCategory[]
  priceHistories         PriceHistory[]
  purchaseOrders         PurchaseOrder[]
  purchases              Purchase[]
  purchaseReturns        PurchaseReturn[]
  purchasePayments       PurchasePayment[]
  shifts                 Shift[]
  sales                  Sale[]
  saleReturns            SaleReturn[]
  stockOpnamesCreated    StockOpname[]      @relation("OpnameCreatedBy")
  stockOpnamesApproved   StockOpname[]      @relation("OpnameApprovedBy")
  stockCards             StockCard[]
  journalEntries         JournalEntry[]
  appSettingsUpdated     AppSetting[]
  loginHistories         LoginHistory[]
  activityLogs           ActivityLog[]

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String?
  userId     String
  action     String
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  user     User      @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model LoginHistory {
  id              String      @id @default(cuid())
  userId          String
  businessId      String?
  accessId        String?
  ipAddress       String?
  deviceInfo      String?
  userAgent       String?
  status          LoginStatus @default(SUCCESS)
  failReason      String?
  createdAt       DateTime    @default(now())

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business?           @relation(fields: [businessId], references: [id], onDelete: SetNull)
  access   UserBusinessAccess? @relation(fields: [accessId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([businessId])
  @@index([status])
  @@index([createdAt])
}

model ActivityLog {
  id          String         @id @default(cuid())
  userId      String
  businessId  String?
  accessId    String?
  module      ActivityModule
  action      ActivityAction
  entityId    String?
  entityName  String?
  oldData     Json?
  newData     Json?
  description String
  ipAddress   String?
  createdAt   DateTime       @default(now())

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business?           @relation(fields: [businessId], references: [id], onDelete: SetNull)
  access   UserBusinessAccess? @relation(fields: [accessId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([businessId])
  @@index([module])
  @@index([action])
  @@index([entityId])
  @@index([createdAt])
}

// =============================================================================
// DOMAIN 2: MASTER DATA
// =============================================================================

model ProductCategory {
  id          String   @id @default(cuid())
  businessId  String?
  name        String
  parentId    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  business Business?         @relation(fields: [businessId], references: [id], onDelete: SetNull)
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]
  createdBy User?            @relation(fields: [createdById], references: [id])

  @@index([businessId])
  @@index([parentId])
  @@index([createdById])
}

model Unit {
  id         String   @id @default(cuid())
  businessId String?
  name       String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business         Business?         @relation(fields: [businessId], references: [id], onDelete: SetNull)
  productBarcodes  ProductBarcode[]
  productUnits     ProductUnit[]
  stockCards       StockCard[]
  stockOpnameItems StockOpnameItem[]

  @@index([businessId])
}

model Supplier {
  id                   String   @id @default(cuid())
  businessId           String?
  name                 String
  code                 String   @unique
  address              String?
  phone                String?
  email                String?
  contactPerson        String?
  isConsignmentSupplier Boolean @default(false)
  paymentTermDays      Int      @default(30)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  business                 Business?                 @relation(fields: [businessId], references: [id], onDelete: SetNull)
  products                 Product[]
  purchaseOrders           PurchaseOrder[]
  purchases                Purchase[]
  purchaseReturns          PurchaseReturn[]
  consignmentSettlements   ConsignmentSettlement[]

  @@index([businessId])
  @@index([code])
  @@index([isConsignmentSupplier])
}

model Product {
  id          String   @id @default(cuid())
  businessId  String?
  name        String
  genericName String?
  categoryId  String
  isConsignment Boolean @default(false)
  supplierId  String?
  minStock    Decimal  @default(0) @db.Decimal(12, 4)
  maxStock    Decimal  @default(0) @db.Decimal(12, 4)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business      Business?        @relation(fields: [businessId], references: [id], onDelete: SetNull)
  category      ProductCategory  @relation(fields: [categoryId], references: [id])
  supplier      Supplier?        @relation(fields: [supplierId], references: [id])
  barcodes      ProductBarcode[]
  productUnits  ProductUnit[]
  priceHistories PriceHistory[]
  productBatches ProductBatch[]
  stockCards    StockCard[]
  stockOpnameItems StockOpnameItem[]
  purchaseOrderItems PurchaseOrderItem[]
  purchaseItems PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]
  saleItems     SaleItem[]
  saleReturnItems SaleReturnItem[]
  consignmentSettlementItems ConsignmentSettlementItem[]
  promoProducts  PromoProduct[]
  onlineOrderItems OnlineOrderItem[]

  @@index([businessId])
  @@index([categoryId])
  @@index([supplierId])
  @@index([isActive])
  @@index([isConsignment])
}

model ProductBarcode {
  id        String @id @default(cuid())
  productId String
  barcode   String @unique
  unitId    String

  product Product @relation(fields: [productId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id])

  @@index([productId])
  @@index([barcode])
  @@index([unitId])
}

model ProductUnit {
  id               String   @id @default(cuid())
  productId        String
  unitId           String
  conversionFactor Decimal  @db.Decimal(12, 4)
  isBaseUnit       Boolean  @default(false)
  buyPrice         Decimal  @db.Decimal(15, 2)
  sellPrice        Decimal  @db.Decimal(15, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product        Product        @relation(fields: [productId], references: [id])
  unit           Unit           @relation(fields: [unitId], references: [id])
  priceHistories PriceHistory[]
  productBatches ProductBatch[]
  purchaseOrderItems PurchaseOrderItem[]
  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]

  @@unique([productId, unitId])
  @@index([productId])
  @@index([unitId])
  @@index([isBaseUnit])
}

model PriceHistory {
  id            String   @id @default(cuid())
  businessId    String?
  productId     String
  productUnitId String
  oldSellPrice  Decimal  @db.Decimal(15, 2)
  newSellPrice  Decimal  @db.Decimal(15, 2)
  oldMarginPct  Decimal? @db.Decimal(8, 4)
  newMarginPct  Decimal? @db.Decimal(8, 4)
  changedById   String
  reason        String?
  createdAt     DateTime @default(now())

  business    Business?   @relation(fields: [businessId], references: [id], onDelete: SetNull)
  product     Product     @relation(fields: [productId], references: [id])
  productUnit ProductUnit @relation(fields: [productUnitId], references: [id])
  changedBy   User        @relation(fields: [changedById], references: [id])

  @@index([businessId])
  @@index([productId])
  @@index([productUnitId])
  @@index([changedById])
  @@index([createdAt])
}

// =============================================================================
// DOMAIN 3: INVENTORY & BATCH
// =============================================================================

model ProductBatch {
  id            String   @id @default(cuid())
  businessId    String?
  productId     String
  productUnitId String
  batchNumber   String
  expiredDate   DateTime
  quantity      Decimal  @db.Decimal(12, 4)
  buyPrice      Decimal  @db.Decimal(15, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business    Business?    @relation(fields: [businessId], references: [id], onDelete: SetNull)
  product     Product      @relation(fields: [productId], references: [id])
  productUnit ProductUnit  @relation(fields: [productUnitId], references: [id])
  stockCards  StockCard[]
  stockOpnameItems StockOpnameItem[]
  purchaseReturnItems PurchaseReturnItem[]
  saleItems   SaleItem[]
  saleReturnItems SaleReturnItem[]

  @@unique([productId, batchNumber])
  @@index([businessId])
  @@index([productId])
  @@index([productUnitId])
  @@index([batchNumber])
  @@index([expiredDate])
  @@index([quantity])
}

model StockCard {
  id              String               @id @default(cuid())
  businessId      String?
  productId       String
  batchId         String?
  transactionType StockTransactionType
  transactionRef  String
  quantityIn      Decimal              @default(0) @db.Decimal(12, 4)
  quantityOut     Decimal              @default(0) @db.Decimal(12, 4)
  balanceBefore   Decimal              @db.Decimal(12, 4)
  balanceAfter    Decimal              @db.Decimal(12, 4)
  unitId          String
  notes           String?
  createdById     String
  createdAt       DateTime             @default(now())

  business  Business?    @relation(fields: [businessId], references: [id], onDelete: SetNull)
  product   Product      @relation(fields: [productId], references: [id])
  batch     ProductBatch? @relation(fields: [batchId], references: [id])
  unit      Unit         @relation(fields: [unitId], references: [id])
  createdBy User         @relation(fields: [createdById], references: [id])

  @@index([businessId])
  @@index([productId])
  @@index([batchId])
  @@index([unitId])
  @@index([createdById])
  @@index([transactionType])
  @@index([createdAt])
  @@index([transactionRef])
}

model StockOpname {
  id           String       @id @default(cuid())
  businessId   String?
  opnameNumber String       @unique
  opnameDate   DateTime
  status       OpnameStatus @default(DRAFT)
  notes        String?
  createdById  String
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  business   Business?         @relation(fields: [businessId], references: [id], onDelete: SetNull)
  createdBy  User              @relation("OpnameCreatedBy", fields: [createdById], references: [id])
  approvedBy User?             @relation("OpnameApprovedBy", fields: [approvedById], references: [id])
  items      StockOpnameItem[]

  @@index([businessId])
  @@index([createdById])
  @@index([approvedById])
  @@index([status])
  @@index([opnameDate])
}

model StockOpnameItem {
  id          String   @id @default(cuid())
  opnameId    String
  productId   String
  batchId     String?
  systemQty   Decimal  @db.Decimal(12, 4)
  physicalQty Decimal  @db.Decimal(12, 4)
  difference  Decimal  @db.Decimal(12, 4)
  unitId      String
  notes       String?

  opname  StockOpname  @relation(fields: [opnameId], references: [id])
  product Product      @relation(fields: [productId], references: [id])
  batch   ProductBatch? @relation(fields: [batchId], references: [id])
  unit    Unit         @relation(fields: [unitId], references: [id])

  @@index([opnameId])
  @@index([productId])
  @@index([batchId])
  @@index([unitId])
}

model ConsignmentSettlement {
  id               String            @id @default(cuid())
  businessId       String?
  supplierId       String
  settlementNumber String            @unique
  periodStart      DateTime
  periodEnd        DateTime
  totalSold        Decimal           @db.Decimal(12, 4)
  totalValue       Decimal           @db.Decimal(15, 2)
  commissionRate   Decimal           @db.Decimal(8, 4)
  commissionAmount Decimal           @db.Decimal(15, 2)
  status           ConsignmentStatus @default(DRAFT)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  business Business?                   @relation(fields: [businessId], references: [id], onDelete: SetNull)
  supplier Supplier                    @relation(fields: [supplierId], references: [id])
  items    ConsignmentSettlementItem[]

  @@index([businessId])
  @@index([supplierId])
  @@index([status])
  @@index([periodStart, periodEnd])
}

model ConsignmentSettlementItem {
  id           String  @id @default(cuid())
  settlementId String
  productId    String
  qtySold      Decimal @db.Decimal(12, 4)
  sellPrice    Decimal @db.Decimal(15, 2)
  buyPrice     Decimal @db.Decimal(15, 2)
  subtotal     Decimal @db.Decimal(15, 2)

  settlement ConsignmentSettlement @relation(fields: [settlementId], references: [id])
  product    Product               @relation(fields: [productId], references: [id])

  @@index([settlementId])
  @@index([productId])
}

// =============================================================================
// DOMAIN 4: PURCHASING
// =============================================================================

model PurchaseOrder {
  id           String              @id @default(cuid())
  businessId   String?
  poNumber     String              @unique
  supplierId   String
  orderDate    DateTime
  expectedDate DateTime?
  status       PurchaseOrderStatus @default(DRAFT)
  notes        String?
  createdById  String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  business   Business?           @relation(fields: [businessId], references: [id], onDelete: SetNull)
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  createdBy  User                @relation(fields: [createdById], references: [id])
  items      PurchaseOrderItem[]
  purchases  Purchase[]

  @@index([businessId])
  @@index([supplierId])
  @@index([createdById])
  @@index([status])
  @@index([orderDate])
}

model PurchaseOrderItem {
  id            String  @id @default(cuid())
  poId          String
  productId     String
  productUnitId String
  orderedQty    Decimal @db.Decimal(12, 4)
  receivedQty   Decimal @default(0) @db.Decimal(12, 4)
  buyPrice      Decimal @db.Decimal(15, 2)
  discount      Decimal @default(0) @db.Decimal(8, 4)
  subtotal      Decimal @db.Decimal(15, 2)

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])
  productUnit   ProductUnit   @relation(fields: [productUnitId], references: [id])

  @@index([poId])
  @@index([productId])
  @@index([productUnitId])
}

model Purchase {
  id             String         @id @default(cuid())
  businessId     String?
  purchaseNumber String         @unique
  supplierId     String
  poId           String?
  invoiceNumber  String?
  invoiceDate    DateTime?
  dueDate        DateTime?
  status         PurchaseStatus @default(DRAFT)
  subtotal       Decimal        @db.Decimal(15, 2)
  discountAmount Decimal        @default(0) @db.Decimal(15, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(15, 2)
  totalAmount    Decimal        @db.Decimal(15, 2)
  paidAmount     Decimal        @default(0) @db.Decimal(15, 2)
  notes          String?
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  business        Business?         @relation(fields: [businessId], references: [id], onDelete: SetNull)
  supplier        Supplier          @relation(fields: [supplierId], references: [id])
  purchaseOrder   PurchaseOrder?    @relation(fields: [poId], references: [id])
  createdBy       User              @relation(fields: [createdById], references: [id])
  items           PurchaseItem[]
  purchaseReturns PurchaseReturn[]
  payments        PurchasePayment[]

  @@index([businessId])
  @@index([supplierId])
  @@index([poId])
  @@index([createdById])
  @@index([status])
  @@index([invoiceDate])
  @@index([dueDate])
}

model PurchaseItem {
  id            String   @id @default(cuid())
  purchaseId    String
  productId     String
  productUnitId String
  batchNumber   String
  expiredDate   DateTime
  quantity      Decimal  @db.Decimal(12, 4)
  buyPrice      Decimal  @db.Decimal(15, 2)
  discount      Decimal  @default(0) @db.Decimal(8, 4)
  subtotal      Decimal  @db.Decimal(15, 2)

  purchase      Purchase      @relation(fields: [purchaseId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])
  productUnit   ProductUnit   @relation(fields: [productUnitId], references: [id])
  returnItems   PurchaseReturnItem[]

  @@index([purchaseId])
  @@index([productId])
  @@index([productUnitId])
}

model PurchaseReturn {
  id           String               @id @default(cuid())
  businessId   String?
  returnNumber String               @unique
  purchaseId   String
  supplierId   String
  returnDate   DateTime
  reason       String?
  totalAmount  Decimal              @db.Decimal(15, 2)
  status       PurchaseReturnStatus @default(DRAFT)
  notes        String?
  createdById  String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  business    Business?            @relation(fields: [businessId], references: [id], onDelete: SetNull)
  purchase    Purchase             @relation(fields: [purchaseId], references: [id])
  supplier    Supplier             @relation(fields: [supplierId], references: [id])
  createdBy   User                 @relation(fields: [createdById], references: [id])
  items       PurchaseReturnItem[]

  @@index([businessId])
  @@index([purchaseId])
  @@index([supplierId])
  @@index([createdById])
  @@index([status])
}

model PurchaseReturnItem {
  id             String  @id @default(cuid())
  returnId       String
  purchaseItemId String
  productId      String
  batchId        String
  quantity       Decimal @db.Decimal(12, 4)
  buyPrice       Decimal @db.Decimal(15, 2)
  subtotal       Decimal @db.Decimal(15, 2)

  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id])
  purchaseItem   PurchaseItem   @relation(fields: [purchaseItemId], references: [id])
  product        Product        @relation(fields: [productId], references: [id])
  batch          ProductBatch   @relation(fields: [batchId], references: [id])

  @@index([returnId])
  @@index([purchaseItemId])
  @@index([productId])
  @@index([batchId])
}

model PurchasePayment {
  id              String        @id @default(cuid())
  businessId      String?
  purchaseId      String
  paymentDate     DateTime
  amount          Decimal       @db.Decimal(15, 2)
  paymentMethod   PaymentMethod
  referenceNumber String?
  notes           String?
  createdById     String
  createdAt       DateTime      @default(now())

  business  Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  purchase  Purchase  @relation(fields: [purchaseId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([businessId])
  @@index([purchaseId])
  @@index([createdById])
  @@index([paymentDate])
}

// =============================================================================
// DOMAIN 5: CUSTOMERS & CRM
// =============================================================================

model Customer {
  id          String       @id @default(cuid())
  businessId  String?
  name        String
  phone       String?
  email       String?
  address     String?
  memberCode  String?      @unique
  tier        CustomerTier?
  points      Int          @default(0)
  dateOfBirth DateTime?
  gender      String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  business    Business?     @relation(fields: [businessId], references: [id], onDelete: SetNull)
  sales       Sale[]
  waLogs      WaLog[]
  onlineOrders OnlineOrder[]

  @@index([businessId])
  @@index([memberCode])
  @@index([phone])
  @@index([tier])
  @@index([isActive])
}

model MemberTier {
  id          String   @id @default(cuid())
  businessId  String?
  name        String   @unique
  minPoints   Int
  discountPct Decimal  @db.Decimal(8, 4)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([minPoints])
}

model Promo {
  id                String       @id @default(cuid())
  businessId        String?
  name              String
  promoCode         String?      @unique
  promoType         PromoType
  value             Decimal      @db.Decimal(15, 4)
  minPurchase       Decimal      @default(0) @db.Decimal(15, 2)
  maxDiscount       Decimal?     @db.Decimal(15, 2)
  applicableToTier  CustomerTier?
  startDate         DateTime
  endDate           DateTime
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  business      Business?      @relation(fields: [businessId], references: [id], onDelete: SetNull)
  promoProducts PromoProduct[]

  @@index([businessId])
  @@index([promoCode])
  @@index([isActive])
  @@index([startDate, endDate])
  @@index([promoType])
}

model PromoProduct {
  id        String  @id @default(cuid())
  promoId   String
  productId String?

  promo   Promo    @relation(fields: [promoId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@index([promoId])
  @@index([productId])
}

model Doctor {
  id            String   @id @default(cuid())
  businessId    String?
  name          String
  specialization String?
  licenseNumber String?  @unique
  phone         String?
  address       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  sales    Sale[]

  @@index([businessId])
  @@index([isActive])
  @@index([licenseNumber])
}

model WaTemplate {
  id         String         @id @default(cuid())
  businessId String?
  name       String
  type       WaTemplateType
  content    String
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  waLogs   WaLog[]

  @@index([businessId])
  @@index([type])
  @@index([isActive])
}

model WaLog {
  id          String      @id @default(cuid())
  businessId  String?
  templateId  String?
  customerId  String?
  phoneNumber String
  message     String
  status      WaLogStatus @default(PENDING)
  sentAt      DateTime?
  error       String?
  createdAt   DateTime    @default(now())

  business Business?   @relation(fields: [businessId], references: [id], onDelete: SetNull)
  template WaTemplate? @relation(fields: [templateId], references: [id])
  customer Customer?   @relation(fields: [customerId], references: [id])

  @@index([businessId])
  @@index([templateId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

// =============================================================================
// DOMAIN 6: SALES & POS
// =============================================================================

model Shift {
  id           String      @id @default(cuid())
  businessId   String?
  shiftNumber  String      @unique
  userId       String
  openedAt     DateTime    @default(now())
  closedAt     DateTime?
  openingCash  Decimal     @db.Decimal(15, 2)
  closingCash  Decimal?    @db.Decimal(15, 2)
  expectedCash Decimal?    @db.Decimal(15, 2)
  cashDifference Decimal?  @db.Decimal(15, 2)
  status       ShiftStatus @default(OPEN)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  user     User      @relation(fields: [userId], references: [id])
  sales    Sale[]

  @@index([businessId])
  @@index([userId])
  @@index([status])
  @@index([openedAt])
}

model Sale {
  id                 String     @id @default(cuid())
  businessId         String?
  saleNumber         String     @unique
  saleType           SaleType   @default(GENERAL)
  shiftId            String
  customerId         String?
  doctorId           String?
  prescriptionNumber String?
  compoundingFee     Decimal    @default(0) @db.Decimal(15, 2)
  embalaseFee        Decimal    @default(0) @db.Decimal(15, 2)
  subtotal           Decimal    @db.Decimal(15, 2)
  discountAmount     Decimal    @default(0) @db.Decimal(15, 2)
  taxAmount          Decimal    @default(0) @db.Decimal(15, 2)
  totalAmount        Decimal    @db.Decimal(15, 2)
  status             SaleStatus @default(DRAFT)
  notes              String?
  createdById        String
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  business    Business?     @relation(fields: [businessId], references: [id], onDelete: SetNull)
  shift       Shift         @relation(fields: [shiftId], references: [id])
  customer    Customer?     @relation(fields: [customerId], references: [id])
  doctor      Doctor?       @relation(fields: [doctorId], references: [id])
  createdBy   User          @relation(fields: [createdById], references: [id])
  items       SaleItem[]
  payments    SalePayment[]
  saleReturns SaleReturn[]

  @@index([businessId])
  @@index([shiftId])
  @@index([customerId])
  @@index([doctorId])
  @@index([createdById])
  @@index([status])
  @@index([saleType])
  @@index([createdAt])
}

model SaleItem {
  id                     String   @id @default(cuid())
  saleId                 String
  productId              String
  batchId                String?
  productUnitId          String
  quantity               Decimal  @db.Decimal(12, 4)
  sellPrice              Decimal  @db.Decimal(15, 2)
  costPrice              Decimal  @db.Decimal(15, 2)
  discountPct            Decimal  @default(0) @db.Decimal(8, 4)
  discountAmount         Decimal  @default(0) @db.Decimal(15, 2)
  subtotal               Decimal  @db.Decimal(15, 2)
  isCompoundingComponent Boolean  @default(false)

  sale        Sale          @relation(fields: [saleId], references: [id])
  product     Product       @relation(fields: [productId], references: [id])
  batch       ProductBatch? @relation(fields: [batchId], references: [id])
  productUnit ProductUnit   @relation(fields: [productUnitId], references: [id])
  returnItems SaleReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@index([batchId])
  @@index([productUnitId])
}

model SalePayment {
  id              String            @id @default(cuid())
  saleId          String
  paymentMethod   SalePaymentMethod
  amount          Decimal           @db.Decimal(15, 2)
  referenceNumber String?
  createdAt       DateTime          @default(now())

  sale Sale @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@index([paymentMethod])
}

model SaleReturn {
  id           String           @id @default(cuid())
  businessId   String?
  returnNumber String           @unique
  saleId       String
  returnDate   DateTime
  reason       String?
  totalAmount  Decimal          @db.Decimal(15, 2)
  status       SaleReturnStatus @default(DRAFT)
  notes        String?
  createdById  String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  business  Business?        @relation(fields: [businessId], references: [id], onDelete: SetNull)
  sale      Sale             @relation(fields: [saleId], references: [id])
  createdBy User             @relation(fields: [createdById], references: [id])
  items     SaleReturnItem[]

  @@index([businessId])
  @@index([saleId])
  @@index([createdById])
  @@index([status])
}

model SaleReturnItem {
  id         String  @id @default(cuid())
  returnId   String
  saleItemId String
  productId  String
  batchId    String
  quantity   Decimal @db.Decimal(12, 4)
  sellPrice  Decimal @db.Decimal(15, 2)
  subtotal   Decimal @db.Decimal(15, 2)

  saleReturn SaleReturn   @relation(fields: [returnId], references: [id])
  saleItem   SaleItem     @relation(fields: [saleItemId], references: [id])
  product    Product      @relation(fields: [productId], references: [id])
  batch      ProductBatch @relation(fields: [batchId], references: [id])

  @@index([returnId])
  @@index([saleItemId])
  @@index([productId])
  @@index([batchId])
}

model OnlineOrder {
  id              String            @id @default(cuid())
  businessId      String?
  orderNumber     String            @unique
  channel         OnlineChannel
  externalOrderId String?
  customerId      String?
  status          OnlineOrderStatus @default(PENDING)
  rawPayload      Json?
  totalAmount     Decimal           @db.Decimal(15, 2)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  business Business?         @relation(fields: [businessId], references: [id], onDelete: SetNull)
  customer Customer?         @relation(fields: [customerId], references: [id])
  items    OnlineOrderItem[]

  @@index([businessId])
  @@index([customerId])
  @@index([channel])
  @@index([status])
  @@index([externalOrderId])
}

model OnlineOrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  quantity    Decimal @db.Decimal(12, 4)
  sellPrice   Decimal @db.Decimal(15, 2)
  subtotal    Decimal @db.Decimal(15, 2)

  order   OnlineOrder @relation(fields: [orderId], references: [id])
  product Product?    @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

// =============================================================================
// DOMAIN 7: ACCOUNTING
// =============================================================================

model ChartOfAccount {
  id          String      @id @default(cuid())
  businessId  String?
  accountCode String      @unique
  accountName String
  accountType AccountType
  parentId    String?
  isActive    Boolean     @default(true)
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  business     Business?        @relation(fields: [businessId], references: [id], onDelete: SetNull)
  parent       ChartOfAccount?  @relation("CoaTree", fields: [parentId], references: [id])
  children     ChartOfAccount[] @relation("CoaTree")
  journalLines JournalLine[]

  @@index([businessId])
  @@index([parentId])
  @@index([accountType])
  @@index([isActive])
  @@index([accountCode])
}

model JournalEntry {
  id             String               @id @default(cuid())
  businessId     String?
  entryNumber    String               @unique
  entryDate      DateTime
  description    String?
  reference      String?
  referenceType  JournalReferenceType?
  totalDebit     Decimal              @db.Decimal(15, 2)
  totalCredit    Decimal              @db.Decimal(15, 2)
  isPosted       Boolean              @default(false)
  createdById    String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  business  Business?     @relation(fields: [businessId], references: [id], onDelete: SetNull)
  createdBy User          @relation(fields: [createdById], references: [id])
  lines     JournalLine[]

  @@index([businessId])
  @@index([createdById])
  @@index([entryDate])
  @@index([referenceType])
  @@index([reference])
  @@index([isPosted])
}

model JournalLine {
  id          String   @id @default(cuid())
  journalId   String
  accountId   String
  description String?
  debit       Decimal  @default(0) @db.Decimal(15, 2)
  credit      Decimal  @default(0) @db.Decimal(15, 2)
  createdAt   DateTime @default(now())

  journal JournalEntry   @relation(fields: [journalId], references: [id])
  account ChartOfAccount @relation(fields: [accountId], references: [id])

  @@index([journalId])
  @@index([accountId])
}

// =============================================================================
// DOMAIN 8: SETTINGS
// =============================================================================

model AppSetting {
  id          String   @id @default(cuid())
  businessId  String?
  key         String   @unique
  value       String
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt

  business  Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  updatedBy User?     @relation(fields: [updatedById], references: [id])

  @@index([businessId])
  @@index([updatedById])
}

model OnlineChannelConfig {
  id            String        @id @default(cuid())
  businessId    String?
  channel       OnlineChannel @unique
  apiKey        String?
  apiSecret     String?
  webhookSecret String?
  isActive      Boolean       @default(false)
  lastSyncAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([channel])
  @@index([isActive])
}
